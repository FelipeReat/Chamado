  <system.webServer>
    <rewrite>
      <rules>
        <!-- Proxy /api para o backend Node (ARR necessário) -->
        <rule name="API Reverse Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:3004/api/{R:1}" />
        </rule>

        <!-- Arquivos estáticos existentes -->
        <rule name="Static Files" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- SPA fallback para rotas do frontend -->
