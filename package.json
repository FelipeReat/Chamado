{
  "name": "locador-chamados",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "client:dev": "vite",
    "build": "vite build && npm run build:api",
    "build:api": "tsc -p tsconfig.api.json",
    "build:prod": "vite build && npm run build:api",
    "start": "node dist/api/server.js",
    "pm2:start": "pnpm exec pm2 start ecosystem.config.cjs",
    "pm2:restart": "pnpm exec pm2 restart locador-api",
    "pm2:stop": "pnpm exec pm2 stop locador-api && pnpm exec pm2 delete locador-api",
    "pm2:logs": "pnpm exec pm2 logs locador-api",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "server:dev": "nodemon",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "start:api": "node dist/api/server.js",
    "test": "vitest run",
    "setup:admin": "tsx scripts/setup-admin.ts",
    "migrate:default-board": "tsx scripts/migrate-default-board.ts",
    "setup:db": "tsx scripts/setup-db.ts",
    "migrate:db": "tsx scripts/migrate-json-to-db.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.80.0",
    "@types/nodemailer": "^7.0.3",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "recharts": "^3.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^24.1.3",
    "nodemon": "^3.1.10",
    "pm2": "^6.0.13",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  }
}
