{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist/api",
    "rootDir": "api",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": false,
    "sourceMap": true
  },
  "include": [
    "api/**/*.ts",
    "api/**/*.js"
  ]
}
